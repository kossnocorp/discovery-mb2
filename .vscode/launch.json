{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug-meet-your-software",
      "type": "probe-rs-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}/mdbook/src/05-meet-your-software",
      "preLaunchTask": "build-meet-your-software",
      "runtimeExecutable": "probe-rs",
      "runtimeArgs": ["dap-server"],
      "chip": "nRF52833_xxAA",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": false,
        "formatOptions": {}
